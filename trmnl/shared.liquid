<style>
  .lc{display:flex;flex-direction:column;gap:6px;width:100%;height:100%;font-family:'Inter','Helvetica Neue',Arial,sans-serif;}
  .lc-main{flex:1;min-height:0;display:flex;gap:8px;}
  .lc-card{flex:1;min-width:0;min-height:0;position:relative;border:2px solid #000;border-radius:10px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fff;text-align:center;}
  /* --- OFFLINE --- */
  .lc-ava{border-radius:50%;object-fit:cover;border:3px solid #000;}
  .lc-state{font-weight:900;line-height:1;}
  .lc-name{font-weight:700;max-width:94%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .lc-sub{max-width:94%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .n1 .lc-ava{width:160px;height:160px}.n1 .lc-state{font-size:68px;letter-spacing:4px;margin-top:16px}.n1 .lc-name{font-size:28px;margin-top:10px}.n1 .lc-sub{font-size:19px;margin-top:4px}
  .n2 .lc-ava{width:130px;height:130px}.n2 .lc-state{font-size:52px;letter-spacing:3px;margin-top:14px}.n2 .lc-name{font-size:23px;margin-top:9px}.n2 .lc-sub{font-size:16px;margin-top:3px}
  .n3 .lc-ava{width:104px;height:104px}.n3 .lc-state{font-size:37px;letter-spacing:1px;margin-top:12px}.n3 .lc-name{font-size:18px;margin-top:8px}.n3 .lc-sub{font-size:13px;margin-top:3px}
  .n4 .lc-ava{width:84px;height:84px}.n4 .lc-state{font-size:28px;margin-top:10px}.n4 .lc-name{font-size:15px;margin-top:7px}.n4 .lc-sub{font-size:12px;margin-top:2px}
  /* --- LIVE: thanh tiêu đề + ảnh màn hình chiếm phần còn lại --- */
  .lv{justify-content:flex-start;}
  .lv-head{width:100%;flex:none;display:flex;align-items:center;gap:8px;background:#000;color:#fff;font-weight:800;padding:5px 10px;white-space:nowrap;line-height:1.2;text-align:left;}
  .lv-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;}
  .lv-tag{flex:none;border:2px solid #fff;border-radius:5px;padding:0 6px;font-size:0.8em;letter-spacing:1px;}
  .lv-eye{flex:none;display:flex;align-items:center;gap:4px;}
  .lv-eye svg{width:1.15em;height:1.15em;}
  .lv-img{flex:1;min-height:0;width:100%;display:flex;align-items:center;justify-content:center;}
  .lv-img img{width:100%;height:100%;object-fit:contain;}
  .lv-ph{font-size:40px;font-weight:900;}
  .l1 .lv-head{font-size:22px;padding:6px 14px}.l2 .lv-head{font-size:18px}.l3 .lv-head{font-size:15px;gap:6px;padding:4px 7px}.l4 .lv-head{font-size:13px;gap:5px;padding:3px 6px}
  .l3 .lv-tag,.l4 .lv-tag{border-width:1px;padding:0 4px}
  /* --- Bố cục trộn: ô live co theo tỉ lệ ảnh + cột offline dạng collage --- */
  .lc-main.mix{container-type:size;justify-content:center;}
  .mix .lv{flex:0 1 auto;width:calc((100cqh - var(--hh)) * var(--ar) + 4px);min-width:150px;}
  .mix.l1 .lv{min-width:270px}.mix.l2 .lv{min-width:200px}
  .l1{--hh:38px}.l2{--hh:33px}.l3{--hh:28px}.l4{--hh:25px}
  .off-col{flex:1 1 0;min-width:150px;display:flex;flex-direction:column;gap:8px;}
  .off-cell{flex:1 1 0;min-height:0;border:2px solid #000;border-radius:10px;display:flex;align-items:center;gap:10px;padding:6px 10px;overflow:hidden;text-align:left;}
  .off-ava{flex:none;width:58px;height:58px;border-radius:50%;object-fit:cover;border:2px solid #000;}
  .off-txt{flex:1;min-width:0;}
  .off-name{font-weight:800;font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .off-state{font-weight:900;font-size:19px;letter-spacing:1px;line-height:1.1;}
  .off-sub{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .off-col.c1 .off-ava{width:96px;height:96px}.off-col.c1 .off-name{font-size:22px}.off-col.c1 .off-state{font-size:28px}
  .off-col.c2 .off-ava{width:76px;height:76px}.off-col.c2 .off-name{font-size:19px}.off-col.c2 .off-state{font-size:23px}
  /* --- Thanh trạng thái --- */
  .sb{flex:none;display:flex;align-items:center;gap:6px;height:34px;}
  .sb-i{flex:1;min-width:0;display:flex;align-items:center;gap:5px;font-size:13px;padding:4px 8px;border-radius:6px;border:2px solid #000;white-space:nowrap;}
  .sb-i.on{background:#000;color:#fff;font-weight:800;}
  .sb-n{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;}
  .sb-s{font-weight:800;font-size:11px;}
  .sb-t{flex:none;font-size:12px;white-space:nowrap;padding-left:2px;}
</style>
