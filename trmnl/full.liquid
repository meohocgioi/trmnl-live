{% assign lives = users | where: "live", true %}
{% assign nl = lives.size %}{% if nl > 4 %}{% assign nl = 4 %}{% endif %}
{% assign n = users.size %}{% if n > 4 %}{% assign n = 4 %}{% endif %}
<div class="layout" style="padding:0;">
  <div class="lc">
    <div class="lc-main {% if nl > 0 %}mix l{{ nl }}{% else %}n{{ n }}{% endif %}">
      {% if nl > 0 %}
        {% for u in lives limit:nl %}
        <div class="lc-card lv" style="--ar:{{ u.ar | default: 0.5625 }}">
          <div class="lv-head">
            <span class="lv-name">{{ u.user }}</span>
            <span class="lv-tag">LIVE</span>
            {% if u.viewers != "" %}<span class="lv-eye">{{ u.viewers }}<svg viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M12 5C6.5 5 2.7 8.6 1 12c1.7 3.4 5.5 7 11 7s9.3-3.6 11-7c-1.7-3.4-5.5-7-11-7zm0 11.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/></svg></span>{% endif %}
          </div>
          <div class="lv-img">{% if u.image %}<img class="image-dither" src="{{ u.image }}">{% else %}<div class="lv-ph">LIVE</div>{% endif %}</div>
        </div>
        {% endfor %}
        {% assign offs = users | where: "live", false %}
        {% assign no = offs.size %}{% assign room = 4 | minus: nl %}{% if no > room %}{% assign no = room %}{% endif %}
        {% if no > 0 %}
        <div class="off-col c{{ no }}">
          {% for u in offs limit:no %}
          <div class="off-cell">
            {% if u.avatar %}<img class="image-dither off-ava" src="{{ u.avatar }}">{% endif %}
            <div class="off-txt">
              <div class="off-name">{{ u.user }}</div>
              <div class="off-state">{% if u.unknown %}???{% else %}OFFLINE{% endif %}</div>
              <div class="off-sub">{{ u.platform }} · {{ u.checked }}</div>
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      {% else %}
        {% for u in users limit:4 %}
        <div class="lc-card">
          {% if u.avatar %}<img class="image-dither lc-ava" src="{{ u.avatar }}">{% endif %}
          <div class="lc-state">{% if u.unknown %}???{% else %}OFFLINE{% endif %}</div>
          <div class="lc-name">{{ u.user }}</div>
          <div class="lc-sub">{{ u.platform }}{% if u.nickname != u.user %} · {{ u.nickname }}{% endif %}</div>
          <div class="lc-sub">Kiểm tra {{ u.checked }}</div>
        </div>
        {% endfor %}
        {% if n == 0 %}<div style="margin:auto;font-size:28px;">Chưa theo dõi ai — dùng /add trên Telegram</div>{% endif %}
      {% endif %}
    </div>
    <div class="sb">
      {% for u in users limit:4 %}
      <div class="sb-i{% if u.live %} on{% endif %}">
        <span>{% if u.live %}●{% elsif u.unknown %}?{% else %}○{% endif %}</span>
        <span class="sb-n">{{ u.user }}</span>
        <span class="sb-s">{% if u.live %}LIVE{% elsif u.unknown %}??{% else %}OFF{% endif %}</span>
      </div>
      {% endfor %}
      <div class="sb-t">{{ updated }}</div>
    </div>
  </div>
</div>
