<style>
  .cp{display:flex;flex-direction:column;gap:4px;width:100%;height:100%;font-family:'Inter','Helvetica Neue',Arial,sans-serif;}
  .cp-main{flex:1;min-height:0;display:flex;gap:5px;}
  .cp-card{flex:1 1 0;min-width:0;min-height:0;position:relative;border:2px solid #000;border-radius:8px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:#fff;}
  .cp-img{flex:1;min-height:0;width:100%;display:flex;align-items:center;justify-content:center;}
  .cp-img img{width:100%;height:100%;object-fit:contain;}
  .cp-cap{width:100%;border-top:1px solid #000;padding:1px 4px;font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left;}
  .cp-badge{position:absolute;top:3px;left:3px;background:#000;color:#fff;font-weight:800;font-size:10px;padding:0 4px;border-radius:3px;border:1px solid #fff;}
  .cp-state{font-weight:900;line-height:1;}
  .cp-name{font-weight:700;margin-top:3px;max-width:94%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .cp-sub{font-size:10px;margin-top:1px;max-width:94%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .cp-sb{flex:none;display:flex;gap:4px;height:20px;align-items:center;}
  .cp-sb i{flex:1;min-width:0;font-style:normal;font-size:10px;padding:1px 5px;border:1px solid #000;border-radius:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .cp-sb i.on{background:#000;color:#fff;font-weight:800;}
  .cp-t{flex:none;font-size:10px;}
  .cp-main.off{flex-direction:row;}.cp-main.live{flex-direction:row;}
  .n1 .cp-state{font-size:40px}.n1 .cp-name{font-size:20px}.n2 .cp-state{font-size:34px}.n2 .cp-name{font-size:17px}.n3 .cp-state{font-size:26px}.n3 .cp-name{font-size:14px}.n4 .cp-state{font-size:20px}.n4 .cp-name{font-size:12px}
</style>
{% assign lives = users | where: "live", true %}
{% assign nl = lives.size %}{% if nl > 4 %}{% assign nl = 4 %}{% endif %}
{% assign n = users.size %}{% if n > 4 %}{% assign n = 4 %}{% endif %}
<div class="layout" style="padding:0;">
  <div class="cp">
    <div class="cp-main {% if nl > 0 %}live l{{ nl }}{% else %}off n{{ n }}{% endif %}">
      {% if nl > 0 %}
        {% for u in lives limit:nl %}
        <div class="cp-card">
          <div class="cp-img">{% if u.image %}<img class="image-dither" src="{{ u.image }}">{% else %}<div class="cp-state">LIVE</div>{% endif %}</div>
          <div class="cp-badge">● LIVE</div>
          <div class="cp-cap">{{ u.user }} · {{ u.shot }}</div>
        </div>
        {% endfor %}
      {% else %}
        {% for u in users limit:4 %}
        <div class="cp-card">
          <div class="cp-state">{% if u.unknown %}???{% else %}OFFLINE{% endif %}</div>
          <div class="cp-name">{{ u.user }}</div>
          <div class="cp-sub">{{ u.platform }} · {{ u.checked }}</div>
        </div>
        {% endfor %}
      {% endif %}
    </div>
    <div class="cp-sb">
      {% for u in users limit:4 %}<i class="{% if u.live %}on{% endif %}">{% if u.live %}●{% elsif u.unknown %}?{% else %}○{% endif %} {{ u.user }}</i>{% endfor %}
      <span class="cp-t">{{ updated }}</span>
    </div>
  </div>
</div>
