<style>
  .lc-wrap{display:flex;gap:6px;width:100%;height:100%;font-family:'Inter','Helvetica Neue',Arial,sans-serif;flex-direction:row;}
  .lc-card{min-width:0;min-height:0;position:relative;border:2px solid #000;border-radius:8px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;flex:1;}
  .lc-img{width:100%;height:100%;object-fit:contain;background:#000;}
  .lc-badge{position:absolute;top:3px;left:3px;background:#000;color:#fff;font-weight:800;font-size:12px;padding:1px 5px;border-radius:4px;border:1px solid #fff;}
  .lc-foot{position:absolute;left:0;right:0;bottom:0;background:#fff;border-top:1px solid #000;padding:1px 4px;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .lc-state{font-weight:900;line-height:1;}
  .lc-name{font-weight:700;max-width:94%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .lc-sub{font-size:11px;max-width:94%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .n1 .lc-state{font-size:40px}.n1 .lc-name{font-size:20px;margin-top:6px}.n2 .lc-state{font-size:34px}.n2 .lc-name{font-size:17px;margin-top:5px}.n3 .lc-state{font-size:26px}.n3 .lc-name{font-size:14px;margin-top:4px}.n4 .lc-state{font-size:20px}.n4 .lc-name{font-size:12px;margin-top:3px}
</style>
{% assign n = users.size %}{% if n > 4 %}{% assign n = 4 %}{% endif %}
<div class="layout" style="padding:0;">
  <div class="lc-wrap n{{ n }}">
    {% for u in users limit:4 %}
    <div class="lc-card">
      {% if u.live and u.image %}
        <img class="image-dither lc-img" src="{{ u.image }}">
        <div class="lc-badge">● LIVE</div>
        <div class="lc-foot"><b>{{ u.user }}</b> · {{ u.shot }}</div>
      {% else %}
        <div class="lc-state">{% if u.live %}LIVE{% elsif u.unknown %}???{% else %}OFFLINE{% endif %}</div>
        <div class="lc-name">{{ u.user }}</div>
        <div class="lc-sub">{{ u.platform }} · {{ u.checked }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>
<div class="title_bar">
  <span class="title">Live Check</span>
  <span class="instance">{{ updated }}</span>
</div>
